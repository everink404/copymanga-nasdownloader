CMNAS_CM_TOKEN= # 下载鉴权 Token（公开简介和目录不需要）
CMNAS_DOWNLOAD_PATH= # 下载路径(暂存路径，将在cbz打包完成后删除)
CMNAS_CBZ_PATH= # CBZ存放路径
CMNAS_DATA_PATH= # 配置文件相关存放路径
CMNAS_USE_CM_CNAME= # 是否使用copymanga的章节名，如果不使用将按照kavita的格式进行命名
CMNAS_API_URL= # API服务器地址
CMNAS_CM_WEB_URL=https://www.copy4000.com # 官网列表、简介和完整目录（浏览/订阅检查无需登录）
CMNAS_LOG_LEVEL= # 日志等级
CMNAS_CM_USERNAME= # copymanga 账户名称
CMNAS_CM_PASSWORD= # copymanga 密码
CMNAS_CM_PROXY= # copymanga 使用的代理
CMNAS_CM_RATE_LIMIT_PER_MINUTE=12 # CopyManga 请求全局限流（次/分钟），0 关闭

# Push 配置
PUSH_ENABLE=False # 是否开启
PUSH_SERVER="" # 服务器地址
PUSH_USER="" # 用户
PUSH_TOKEN="" # 密钥
PUSH_SUMMARY_ONLY=True # 是否开启汇总模式
PUSH_MARKDOWN=True # 是否开启markdown内容
